if (!isServer) exitWith {};
[] spawn {
    sleep 3;
    private _check={params ["_name","_ok"];diag_log format ["[REDUX_HC_DELAY] %1",[_name,_ok]]};
    diag_log "[REDUX_HC_DELAY] start";
    private _group=createGroup [sideLogic,true];
    private _logic=_group createUnit ["HighCommand",[1000,1000,0],[],0,"NONE"];
    private _sub=_group createUnit ["HighCommandSubordinate",[1005,1000,0],[],0,"NONE"];
    _logic synchronizeObjectsAdd [_sub];
    sleep 3;
    private _worker=_logic getVariable ["A3URF_hcWorker",scriptNull];
    ["empty_waits",!scriptDone _worker && {isNil {_logic getVariable "A3URF_hcNative"}} && {isNil "BIS_MARTA_mainScope"}] call _check;
    [_logic] call A3URF_fnc_initHighCommand;
    ["duplicate_uses_worker",(_logic getVariable ["A3URF_hcWorker",scriptNull]) isEqualTo _worker] call _check;
    private _units=createGroup [independent,true];
    private _commander=_units createUnit ["I_G_Soldier_TL_F",[1010,1000,0],[],0,"NONE"];
    _commander disableAI "ALL";
    _logic synchronizeObjectsAdd [_commander];
    sleep 8;
    ["late_leader_bound",(_commander getVariable ["BIS_HC_scope",objNull])==_logic] call _check;
    ["native_completed",!isNil {_logic getVariable "A3URF_hcNative"} && {scriptDone (_logic getVariable "A3URF_hcNative")}] call _check;
    ["one_marta",count (allMissionObjects "MartaManager")==1] call _check;
    ["main_scope_preserved",BIS_HC_mainscope==_logic] call _check;
    private _other=_group createUnit ["HighCommand",[1020,1000,0],[],0,"NONE"];
    sleep 1;
    private _otherWorker=_other getVariable ["A3URF_hcWorker",scriptNull];
    ["second_empty_waits",!scriptDone _otherWorker] call _check;
    deleteVehicle _other;
    sleep 1;
    ["deleted_scope_stops_worker",scriptDone _otherWorker] call _check;
    diag_log "[REDUX_HC_DELAY] complete";
};
